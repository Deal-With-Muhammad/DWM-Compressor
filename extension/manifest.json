{
  "manifest_version": 3,
  "name": "DWM Compressor",
  "version": "1.0.0",
  "description": "Compress & convert PDFs, images and videos — private, right in your browser.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "DWM Compressor",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js"
  }
}
